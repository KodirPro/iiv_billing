model Transactions {
  id           BigInt             @id @default(autoincrement())
  transId      String?            @db.VarChar(50)
  amount       Int
  createdTime  DateTime           @default(now())
  performTime  DateTime?
  cancelTime   DateTime?
  reason       Int?
  state        Int                @default(1)
  status       ETransactionStatus @default(PENDING)
  provider     EProvider
  merchantId   String?            @db.VarChar(50)
  account      Accounts           @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  accountId    Int
  payment_type EPaymentType?
  // order       Orders?   @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  // orderId     BigInt?
}

model Unauthorized {
  id            Int      @id @default(autoincrement())
  referer       String?  @db.VarChar(255)
  ip            String?  @db.VarChar(50)
  xForwardedFor String?  @db.VarChar(255)
  method        String?  @db.VarChar(20)
  originalUrl   String?  @db.VarChar(50)
  date          DateTime @default(now())
}
